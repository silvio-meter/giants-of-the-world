{
  "name": "giants-of-the-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:data": "node scripts/build-data.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --no-warnings=MODULE_TYPELESS_PACKAGE_JSON \"tests/*.test.mjs\" \"scripts/verify-data.test.mjs\" \"scripts/verify-diacritics.test.mjs\" \"scripts/verify-copy.test.mjs\"",
    "verify": "npm run lint && npm run typecheck && npm test",
    "test:bundle": "REQUIRE_BUILD=1 node --test --no-warnings=MODULE_TYPELESS_PACKAGE_JSON \"scripts/verify-bundle.test.mjs\"",
    "test:seo": "node --test --no-warnings=MODULE_TYPELESS_PACKAGE_JSON \"scripts/verify-seo.test.mjs\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^2.0.1",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stripe": "^8.0.416",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

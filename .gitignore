# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# expansion source material, never committed
#
# These files carry the full paid text of unpublished entries. Git history is
# permanent: once committed, one fork or one extra collaborator puts that text
# beyond recall, and rewriting history to remove it is unreliable and always
# too late. Versioning and backup for this content live outside the repository.
#
# tests/no-expansion-tracked.test.mjs enforces this. The ignore rule states the
# intention; the test is what actually stops it.
docs/expansion/
